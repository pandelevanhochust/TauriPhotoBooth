<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoBooth.Core\PhotoBooth.Core.csproj" />
    <ProjectReference Include="..\PhotoBooth.Hardware\PhotoBooth.Hardware.csproj" />
    <ProjectReference Include="..\PhotoBooth.Imaging\PhotoBooth.Imaging.csproj" />
  </ItemGroup>

  <Target Name="CopyDistUi" AfterTargets="Build" Condition="Exists('..\..\..\ui\dist\index.html')">
    <ItemGroup>
      <DistFiles Include="..\..\..\ui\dist\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(DistFiles)" DestinationFolder="$(TargetDir)ui\dist\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
